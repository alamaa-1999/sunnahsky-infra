# /pds/head.env on the droplet - the head service's config (phase 4a-1).
# No secrets; every value is required and validated at boot (see
# social-app/server/head/config.ts). HEAD_APP_URL and HEAD_HANDLE_DOMAIN
# must equal the app's own compiled constants or the service refuses to
# start. HEAD_BIND_HOST is omitted deliberately: the default is loopback,
# which is correct under network_mode: host (only Caddy should reach it).
HEAD_PORT=3010
HEAD_PDS_URL=http://localhost:3000
HEAD_PUBLIC_PDS_URL=https://pds.sunnahsky.com
HEAD_APP_URL=https://sunnahsky.com
HEAD_HANDLE_DOMAIN=sunnahsky.com
HEAD_SHELL_PATH=/web/index.html
HEAD_ROUTES_PATH=/app/src/routes.ts
HEAD_SITE_NAME=sunnahsky
HEAD_POSITIVE_TTL_MS=180000
HEAD_NEGATIVE_TTL_MS=60000
HEAD_RATE_LIMIT_PER_MIN=60
HEAD_PDS_CONCURRENCY=8
HEAD_BREAKER_FAILURES=5
HEAD_BREAKER_RESET_MS=30000
