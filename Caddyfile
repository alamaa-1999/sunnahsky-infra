# "PDS hostname move and public URL scheme" - Stage 1 of 2 (hostname move
# only). Wildcard handle hosts still plain-proxy every path, exactly as
# they did before this move - Stage 2 (this same repo's next commit)
# switches them to the path-based profile redirect, deployed separately
# and only once this stage is live and verified. Reversing that order
# breaks handle resolution for every account (PDS_HOSTNAME/
# PDS_SERVICE_HANDLE_DOMAINS must already be live on the new hostname
# before a redirect can send anyone to a canonical profile path that
# means anything) - see the plan's own Sequencing section.
{
	email abdullahalam@salafibookstore.com
	on_demand_tls {
		ask http://localhost:3000/tls-check
	}
}

pds.sunnahsky.com {
	# /tls-check is the on_demand_tls "ask" endpoint above. Caddy calls it
	# directly on localhost:3000, never through this site block, so nothing
	# legitimate reaches it via the public host - and with a per-hostname
	# approval limiter behind it, a public caller could otherwise spend a
	# real handle's budget on purpose. Answered here, before reverse_proxy
	# (Caddy orders `respond` ahead of `reverse_proxy` regardless of
	# position in the block, and `respond` is terminal). The PDS also
	# refuses the route when X-Forwarded-For is present, as a backstop.
	@tlscheck path /tls-check
	respond @tlscheck 404
	reverse_proxy http://localhost:3000
}

sunnahsky.com {
	root * /etc/caddy/sunnahsky-web
	try_files {path} /index.html
	file_server
}

app.sunnahsky.com {
	redir https://sunnahsky.com{uri} 301
}

www.sunnahsky.com {
	redir https://sunnahsky.com{uri} 301
}

# Stage 1 only: every handle host still proxies straight through, same as
# before the move - no path-based redirect yet (that's Stage 2).
*.guest.sunnahsky.com, *.sunnahsky.com {
	tls {
		on_demand
	}
	reverse_proxy http://localhost:3000
}
